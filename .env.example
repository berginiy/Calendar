# Скопируйте в .env и задайте свои значения. Файл .env не должен попадать в Git.

# --- База данных ---
POSTGRES_DB=office_booking
DB_URL=jdbc:postgresql://localhost:5432/office_booking
DB_USERNAME=postgres
DB_PASSWORD=change_me

# --- JWT ---
# Не менее 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRATION_MINUTES=60

# --- Приложение (начальные значения; позже меняются руководителем в интерфейсе) ---
APP_TIMEZONE=Asia/Bishkek
APP_OFFICE_CAPACITY=10
APP_ALLOW_SAME_DAY_BOOKING=false
APP_CANCELLATION_DEADLINE_HOURS=0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Первый руководитель (создаётся при старте, если в БД нет ни одного MANAGER) ---
BOOTSTRAP_MANAGER_EMAIL=manager@example.com
BOOTSTRAP_MANAGER_PASSWORD=change_me_please
BOOTSTRAP_MANAGER_FIRST_NAME=Иван
BOOTSTRAP_MANAGER_LAST_NAME=Руководителев

# --- Демо-данные (только для разработки): 15 сотрудников employee01..15@example.com ---
APP_DEMO_DATA=false
APP_DEMO_PASSWORD=
